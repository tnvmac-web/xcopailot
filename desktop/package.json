{
  "name": "xcopilot-desktop",
  "version": "0.1.1",
  "description": "X-Copilot Desktop App — Electron wrapper for the X-Copilot FastAPI server",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "keywords": ["xcopilot", "ai", "agent", "desktop", "electron"],
  "author": "X-Copilot Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.xcopilot.desktop",
    "productName": "X-Copilot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}