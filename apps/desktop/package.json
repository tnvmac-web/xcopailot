{
  "name": "xcopilot-desktop",
  "version": "0.1.1",
  "description": "X-Copilot Desktop App — standalone Electron shell",
  "private": true,
  "type": "module",
  "main": "dist/electron-main.mjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175",
    "dev:electron": "tsc --build tsconfig.electron.json && wait-on http://127.0.0.1:5175 && cross-env XCOPILOT_DESKTOP_DEV_SERVER=http://127.0.0.1:5175 electron .",
    "start": "npm run build && electron .",
    "build": "vite build && tsc --build tsconfig.electron.json",
    "clean": "npm run clean:renderer && npm run clean:electron",
    "clean:renderer": "tsc --build tsconfig.json --clean",
    "clean:electron": "tsc --build tsconfig.electron.json --clean"
  },
  "dependencies": {
    "@xcopilot/shared": "file:../shared",
    "@assistant-ui/react": "^0.10.0",
    "nanostores": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}